{
  "name": "opencode-runner",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run --cwd packages/app dev",
    "build": "bun run --cwd packages/app build",
    "build:web": "bun run --cwd packages/app build:web",
    "typecheck": "bun run --cwd packages/core typecheck && bun run --cwd packages/app typecheck"
  }
}
