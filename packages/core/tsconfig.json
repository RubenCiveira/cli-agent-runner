{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "typeRoots": [
      "../../node_modules/.bun/node_modules",
      "../../node_modules/@types",
      "./node_modules/@types"
    ],
    "types": ["bun-types"]
  },
  "include": ["src/**/*"]
}
